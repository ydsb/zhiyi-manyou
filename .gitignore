# =============================================================================
#  知驿·漫游 —— Git 忽略规则
# =============================================================================

# ------------------------------ 构建产物 ------------------------------
target/
build/
out/
dist/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ------------------------------ 依赖 ------------------------------
node_modules/
.pnpm-store/

# ------------------------------ 日志与临时文件 ------------------------------
*.log
logs/
hs_err_pid*.log
replay_pid*.log
*.tmp
*.bak
*.orig

# ------------------------------ IDE ------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.classpath
.project
nbproject/

# ------------------------------ 操作系统 ------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------ 测试与工具产物 ------------------------------
.playwright-mcp/
surefire-reports/
*.hprof

# ------------------------------ 本地环境（含凭据，绝不入库） ------------------------------
.env
.env.local
.env.*.local
*.local.yml
*.local.yaml
application-local.yml
application-local.properties

# Maven / npm 本地缓存（本项目刻意放在工作区内以避开用户目录权限限制）
.m2repo/
.m2/
.npm-cache/
.mvn-settings-central.xml

# ------------------------------ 用户上传的文件 ------------------------------
# 协作空间的文件存储目录（本地存储模式的落盘位置）。
# 注意：这是运行期用户数据，绝对不应提交。
zhiyi-uploads/
uploads/

# ------------------------------ 含个人信息的材料 ------------------------------
# 项目申报书含真实姓名、学号与指导教师信息，属于公开可见的个人信息，
# 因此不纳入公开仓库。如需归档请另行私下保存。
docs/申报书*.doc
docs/申报书*.docx
docs/申报书*.pdf
*申报书*
# ------------------------------ S3 NLP 服务 ------------------------------
# Python 缓存与虚拟环境
__pycache__/
*.py[cod]
.venv/
venv/
# 训练产物：模型可由 train.py 复现，不入库（避免二进制与语料不一致）
nlp-service/models/
# 测试临时目录
nlp-service/tests/_tmp/