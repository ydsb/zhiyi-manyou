# =============================================================================
#  知驿·漫游 前端 npm 配置
#
#  为什么需要这个文件：
#    1. 沙箱/受限环境下 C:\Users\<user>\AppData\Local\npm-cache 不可写，
#       会导致 npm 报 EPERM。这里把缓存目录改到工作区内。
#    2. 使用国内镜像 npmmirror，安装更快更稳。
#
#  如果你的环境权限正常，可以删掉 cache 一行以使用默认缓存。
# =============================================================================

cache=G:\DEV\.npm-cache
registry=https://registry.npmmirror.com/
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fund=false
audit=false
